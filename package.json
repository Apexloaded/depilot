{
  "name": "depilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed:db": "tsx src/firebase/seed/seed.ts",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "agent:dev": "adk web src/agent/orchestrator.agent.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.0.1",
    "@google/adk": "^1.6.0",
    "@google/genai": "^2.9.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "config": "^5.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "multer": "^2.2.0",
    "prettier": "^3.2.5",
    "proj4": "^2.21.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/adk-devtools": "^1.6.0",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "22.19.3",
    "tsx": "^4.23.12",
    "typescript": "5.5.4",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18"
  }
}