{
  "name": "depilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @repo/firebase --filter depilot dev",
    "build": "pnpm --filter @repo/firebase build && pnpm --filter depilot build",
    "start": "pnpm --filter depilot start",
    "typecheck": "pnpm --filter @repo/firebase build && pnpm --filter depilot typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}